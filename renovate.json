{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePresets": [
    ":prHourlyLimit2"
  ],
  "timezone": "Europe/Berlin",
  "semanticCommits": "disabled",
  "rebaseWhen": "conflicted",
  "gradle": {
    "extends": [
      "schedule:monthly"
    ],
    "enabled": true
  },
  "github-actions": {
    "enabled": true,
    "groupName": "github-actions"
  },
  "packageRules": [
    {
      "description": "OpenCV 4.12+/5.x KleidiCV can call SVE kernels, which SIGILL on BlueStacks Air (macOS). Real Android devices are fine — bump by hand when ready. See app/build.gradle.kts and docs/agents/dependencies.md.",
      "matchPackageNames": ["org.opencv:opencv"],
      "enabled": false
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org.jetbrains.kotlin/",
        "/^com.google.devtools.ksp/",
        "/^androidx.compose.compiler/"
      ]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["renovate::major"],
      "prPriority": -1
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["renovate::minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["renovate::patch"]
    }
  ]
}
