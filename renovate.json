{
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":prHourlyLimit2"
  ],
  "timezone": "Europe/Berlin",
  "semanticCommits": "disabled",
  "rebaseWhen": "conflicted",
  "gradle": {
    "extends": [
      "schedule:monthly"
    ],
    "enabled": true
  },
  "github-actions": {
    "enabled": true,
    "groupName": "github-actions"
  },
  "packageRules": [
    {
      "description": "Verify native initialization and template matching on BlueStacks Air (macOS) before upgrading OpenCV. See docs/agents/dependencies.md.",
      "matchPackageNames": ["org.opencv:opencv"],
      "enabled": false
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org.jetbrains.kotlin/",
        "/^com.google.devtools.ksp/",
        "/^androidx.compose.compiler/"
      ]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["renovate::major"],
      "prPriority": -1
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["renovate::minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["renovate::patch"]
    }
  ]
}
